[Unit]
Description=Chroma nightly customer sync from the Mar-Kov CMS
After=mariadb.service network-online.target
Wants=network-online.target
# The sync is a no-op until the CMS connection is enabled in Admin -> CMS connection.
ConditionPathExists=/opt/chroma/bin/cms-sync

[Service]
Type=oneshot
User=chroma
Group=chroma
Environment=CHROMA_CONFIG=/etc/chroma/config.env
ExecStart=/usr/bin/php /opt/chroma/bin/cms-sync
Nice=10
