# Chroma logs in /var/log/chroma. Installed by install.sh to /etc/logrotate.d/chroma
/var/log/chroma/*.log {
    daily
    rotate 30
    missingok
    notifempty
    compress
    delaycompress
    create 0640 chroma chroma
    su chroma chroma
    sharedscripts
    postrotate
        [ -f /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)" 2>/dev/null || true
        [ -f /run/php/php8.3-fpm.pid ] && kill -USR1 "$(cat /run/php/php8.3-fpm.pid)" 2>/dev/null || true
    endscript
}
