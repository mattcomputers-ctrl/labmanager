# Chroma configuration. The installer writes the real file to /etc/chroma/config.env (mode 600).
# For local development copy this to ./config.env and run: CHROMA_CONFIG=./config.env php -S 127.0.0.1:8080 -t public
APP_ENV=production
APP_DEBUG=0
APP_KEY=change-me
APP_URL=http://chroma.local
APP_SECURE_COOKIES=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chroma
DB_USER=chroma
DB_PASS=secret
# Test database used by the PHPUnit suite (created by the installer).
TEST_DB_NAME=chroma_test
FILES_PATH=/var/lib/chroma/files
LOG_PATH=/var/log/chroma
# Mar-Kov CMS (read-only). Managed from Admin -> CMS connection.
CMS_ENABLED=0
CMS_HOST=
CMS_PORT=1433
CMS_DATABASE=CMS
CMS_USER=
CMS_PASS=
